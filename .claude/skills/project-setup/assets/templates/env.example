# {{PROJECT_NAME}} — environment variables
#
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored and must never be committed.
# Production values live in: <deploy target's settings — fill this in>

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
# APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI models  (required)
# ---------------------------------------------------------------------------
# Get from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Get from: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Database  (required)
# ---------------------------------------------------------------------------
# Supabase — project settings > API
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=      # server-side only, never expose to the client

# MongoDB — Atlas > connect > drivers
# MONGODB_URI=

# ---------------------------------------------------------------------------
# Storage  (optional)
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Observability  (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
